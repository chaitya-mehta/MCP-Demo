{
  "name": "mcp-demo",
  "version": "1.0.0",
  "description": "MCP Server and Client Demo using Node.js, TypeScript, and OpenAI",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/index.js",
    "server": "node --import reflect-metadata --import tsx src/server/index.ts",
    "server:sse": "node --import reflect-metadata --import tsx src/server/sseServer.ts",
    "start:sse": "node dist/server/sseServer.js",
    "client": "node --import tsx src/client/index.ts",
    "client:direct": "node --import tsx src/client/index.ts --direct",
    "test:services": "node --import tsx scripts/verify-services.ts",
    "test:server": "node --import tsx scripts/verify-server.ts",
    "test:client": "node --import tsx scripts/verify-client.ts",
    "inspector": "npx @modelcontextprotocol/inspector node --import tsx src/server/index.ts",
    "migrate": "node --import tsx scripts/migrate.ts",
    "install:claude": "node --import tsx scripts/install-claude.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openai",
    "typescript",
    "ai-agent",
    "tools"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "openai": "^4.86.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.15",
    "typeorm": "^1.1.2",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  }
}
